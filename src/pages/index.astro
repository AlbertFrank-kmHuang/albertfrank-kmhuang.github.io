---
import NavigationBlock from "../components/NavigationBlock.astro";
import "../styles/theme.css";
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Albert Frank</title>
  </head>

  <body>
    <main class="home-stage">
      <section class="identity-area">
        <h1 class="brand">
          <span>Albert</span>
          <span>Frank</span>
        </h1>
      </section>

      <section class="navigation-area">
        <NavigationBlock />
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    margin: 0;
    min-height: 100%;

    background: var(--page-bg);
  }

  :global(body) {
    color: var(--page-fg);

    font-family:
      Inter,
      "PingFang SC",
      "Microsoft YaHei",
      sans-serif;

    overflow-x: hidden;
  }

  .home-stage {
    width: 100%;
    height: 100svh;

    display: grid;
    grid-template-columns: 1fr 1fr;

    overflow: hidden;
  }

  .identity-area {
    display: grid;
    place-items: center;
  }

  .brand {
    margin: 0;

    /*
     * 屏幕中心本来是 50%。
     * 往上移动约 10svh，
     * 于是视觉中心大约落在页面高度的 40%。
     */
    transform: translateY(-10svh);

    font-size: var(--brand-size);
    font-weight: 700;

    line-height: 0.86;
    letter-spacing: -0.055em;

    text-align: right;
  }

  .brand span {
    display: block;
  }

  .navigation-area {
    display: grid;
    place-items: center;
  }

  @media (max-width: 760px) {
    .home-stage {
      height: auto;
      min-height: 100svh;

      grid-template-columns: 1fr;
      grid-template-rows: auto auto;

      gap: 6svh;

      padding:
        9svh
        0
        9svh;
    }

    .identity-area {
      display: block;
    }

    .brand {
      width: 78vw;

      margin:
        0
        auto;

      transform: none;

      font-size:
        clamp(
          3.6rem,
          18vw,
          6rem
        );

      text-align: right;
    }

    .navigation-area {
      display: grid;
      place-items: center;
    }

    :global(:root) {
      --nav-diameter: min(72vw, 420px);
    }
  }
</style>