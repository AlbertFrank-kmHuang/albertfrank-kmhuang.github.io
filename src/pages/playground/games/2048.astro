---
import PlaygroundLayout from "../../../layouts/PlaygroundLayout.astro";
---

<PlaygroundLayout
  title="2048"
  backHref="/playground/game-repository"
  backLabel="游戏仓库"
>
  <section class="game-page">
    <div class="game-header">
      <h1>2048</h1>

      <div class="score-area">
        <div class="score-box">
          <span>得分</span>
          <strong id="score">0</strong>
        </div>
        <div class="score-box">
          <span>最佳</span>
          <strong id="best">0</strong>
        </div>
      </div>
    </div>

    <div class="game-actions">
      <p>合并相同数字，向 2048 前进。</p>
      <button id="new-game" type="button">新游戏</button>
    </div>

    <div id="board" class="board" role="grid" aria-label="2048 游戏棋盘"></div>

    <div class="direction-controls" role="group" aria-label="移动方向">
      <button type="button" data-direction="left" aria-label="向左移动">←</button>
      <button type="button" data-direction="up" aria-label="向上移动">↑</button>
      <button type="button" data-direction="down" aria-label="向下移动">↓</button>
      <button type="button" data-direction="right" aria-label="向右移动">→</button>
    </div>

    <p id="status" class="status" role="status" aria-live="polite">方向键、WASD 或滑动棋盘来移动。</p>
  </section>
</PlaygroundLayout>

<script>
  type Direction = "left" | "right" | "up" | "down";

  const board = document.querySelector<HTMLDivElement>("#board");
  const scoreElement = document.querySelector<HTMLElement>("#score");
  const bestElement = document.querySelector<HTMLElement>("#best");
  const statusElement = document.querySelector<HTMLElement>("#status");
  const newGameButton = document.querySelector<HTMLButtonElement>("#new-game");
  const directionButtons = document.querySelectorAll<HTMLButtonElement>("[data-direction]");

  if (board && scoreElement && bestElement && statusElement && newGameButton) {
    const size = 4;
    const bestKey = "af-space-2048-best";
    let grid = Array<number>(size * size).fill(0);
    let tileElements: HTMLDivElement[] = [];
    let score = 0;
    let best = 0;
    let over = false;
    let reached2048 = false;
    let pointerStart: { x: number; y: number } | null = null;

    try {
      best = Number(localStorage.getItem(bestKey)) || 0;
    } catch {
      best = 0;
    }
    bestElement.textContent = String(best);

    function updateScore(points: number) {
      score += points;
      scoreElement!.textContent = String(score);
      if (score > best) {
        best = score;
        bestElement!.textContent = String(best);
        try {
          localStorage.setItem(bestKey, String(best));
        } catch {
          // 无法使用本地存储时，本局内仍会显示最佳分数。
        }
      }
    }

    function spawnTile() {
      const empty = grid.map((value, index) => value === 0 ? index : -1).filter((index) => index >= 0);
      if (empty.length === 0) return;
      const index = empty[Math.floor(Math.random() * empty.length)];
      grid[index] = Math.random() < 0.9 ? 2 : 4;
    }

    function renderBoard() {
      grid.forEach((value, index) => {
        const tile = tileElements[index];
        const row = Math.floor(index / size) + 1;
        const column = index % size + 1;
        tile.className = value === 0 ? "tile empty" : `tile tile-${Math.min(value, 2048)}`;
        tile.textContent = value === 0 ? "" : String(value);
        tile.setAttribute("aria-label", `第 ${row} 行第 ${column} 列，${value === 0 ? "空" : value}`);
      });
    }

    function lineIndices(direction: Direction, line: number): number[] {
      const indices = Array.from({ length: size }, (_, position) => {
        if (direction === "left" || direction === "right") return line * size + position;
        return position * size + line;
      });
      return direction === "right" || direction === "down" ? indices.reverse() : indices;
    }

    function mergeLine(values: number[]) {
      const compact = values.filter((value) => value !== 0);
      const merged: number[] = [];
      let points = 0;

      for (let index = 0; index < compact.length; index++) {
        if (compact[index] === compact[index + 1]) {
          const value = compact[index] * 2;
          merged.push(value);
          points += value;
          index++;
        } else {
          merged.push(compact[index]);
        }
      }

      while (merged.length < size) merged.push(0);
      return { merged, points };
    }

    function canMove() {
      if (grid.includes(0)) return true;
      for (let row = 0; row < size; row++) {
        for (let column = 0; column < size; column++) {
          const index = row * size + column;
          if (column < size - 1 && grid[index] === grid[index + 1]) return true;
          if (row < size - 1 && grid[index] === grid[index + size]) return true;
        }
      }
      return false;
    }

    function move(direction: Direction) {
      if (over) return;
      const next = [...grid];
      let changed = false;
      let points = 0;

      for (let line = 0; line < size; line++) {
        const indices = lineIndices(direction, line);
        const { merged, points: linePoints } = mergeLine(indices.map((index) => grid[index]));
        points += linePoints;
        indices.forEach((index, position) => {
          if (grid[index] !== merged[position]) changed = true;
          next[index] = merged[position];
        });
      }

      if (!changed) return;
      grid = next;
      updateScore(points);
      spawnTile();
      renderBoard();

      if (!reached2048 && grid.some((value) => value >= 2048)) {
        reached2048 = true;
        statusElement!.textContent = "合成 2048！你可以继续挑战更高数字。";
      }

      if (!canMove()) {
        over = true;
        statusElement!.textContent = "没有可移动的方块了。点击“新游戏”再来一局。";
      }
    }

    function startGame() {
      grid = Array<number>(size * size).fill(0);
      score = 0;
      over = false;
      reached2048 = false;
      scoreElement!.textContent = "0";
      statusElement!.textContent = "方向键、WASD 或滑动棋盘来移动。";
      spawnTile();
      spawnTile();
      renderBoard();
    }

    for (let index = 0; index < size * size; index++) {
      const tile = document.createElement("div");
      tile.className = "tile empty";
      tile.setAttribute("role", "gridcell");
      tileElements.push(tile);
      board.append(tile);
    }

    const keyDirections: Record<string, Direction> = {
      ArrowLeft: "left", ArrowRight: "right", ArrowUp: "up", ArrowDown: "down",
      a: "left", d: "right", w: "up", s: "down",
    };

    document.addEventListener("keydown", (event) => {
      const target = event.target;
      if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) return;
      const direction = keyDirections[event.key] ?? keyDirections[event.key.toLowerCase()];
      if (!direction) return;
      event.preventDefault();
      move(direction);
    });

    board.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "touch" || event.pointerType === "pen") {
        pointerStart = { x: event.clientX, y: event.clientY };
      }
    });

    board.addEventListener("pointerup", (event) => {
      if (!pointerStart) return;
      const x = event.clientX - pointerStart.x;
      const y = event.clientY - pointerStart.y;
      pointerStart = null;
      if (Math.max(Math.abs(x), Math.abs(y)) < 24) return;
      move(Math.abs(x) > Math.abs(y) ? (x > 0 ? "right" : "left") : (y > 0 ? "down" : "up"));
    });

    board.addEventListener("pointercancel", () => {
      pointerStart = null;
    });

    directionButtons.forEach((button) => {
      button.addEventListener("click", () => move(button.dataset.direction as Direction));
    });
    newGameButton.addEventListener("click", startGame);
    startGame();
  }
</script>

<style>
  .game-page {
    width: min(500px, calc(100% - 32px));
    margin: 0 auto;
    padding: 45px 0 100px;
  }

  .game-header,
  .game-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  h1 {
    margin: 0;
    color: var(--playground-fg);
    font-size: clamp(2.8rem, 11vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.07em;
  }

  .score-area {
    display: flex;
    gap: 9px;
  }

  .score-box {
    min-width: 82px;
    padding: 8px 13px;
    border: 1px solid var(--playground-border);
    border-radius: 10px;
    background: var(--playground-card-bg);
    text-align: center;
  }

  .score-box span {
    display: block;
    color: var(--playground-muted);
    font-size: 0.78rem;
  }

  .score-box strong {
    display: block;
    margin-top: 3px;
    font-size: 1.2rem;
    font-variant-numeric: tabular-nums;
  }

  .game-actions {
    margin: 23px 0 16px;
  }

  .game-actions p {
    margin: 0;
    color: var(--playground-muted);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .game-actions button,
  .direction-controls button {
    flex: none;
    padding: 9px 14px;
    border: 1px solid var(--playground-border);
    border-radius: 8px;
    background: var(--playground-card-bg);
    color: var(--playground-fg);
    font: inherit;
    cursor: pointer;
  }

  .game-actions button:hover,
  .direction-controls button:hover {
    border-color: var(--playground-accent);
  }

  button:focus-visible {
    outline: 2px solid var(--playground-accent);
    outline-offset: 3px;
  }

  .board {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
    aspect-ratio: 1;
    padding: 10px;
    border: 1px solid var(--playground-border);
    border-radius: 14px;
    background: #394656;
    touch-action: none;
    user-select: none;
  }

  .board :global(.tile) {
    display: grid;
    place-items: center;
    min-width: 0;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 9px;
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.16), 0 2px 6px rgba(12, 18, 25, 0.12);
    color: #243140;
    font-size: clamp(1.5rem, 6vw, 2.65rem);
    font-weight: 750;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .board :global(.tile.empty) {
    border-color: transparent;
    box-shadow: none;
    background: rgba(19, 27, 39, 0.32);
  }

  .board :global(.tile-2) { background: #dce8f1; }
  .board :global(.tile-4) { background: #bcd9ec; }
  .board :global(.tile-8) { background: #8ccdda; }
  .board :global(.tile-16) { background: #7bd1bb; }
  .board :global(.tile-32) { background: #d5d17e; }
  .board :global(.tile-64) { background: #f0b475; }
  .board :global(.tile-128) { background: #ed9787; }
  .board :global(.tile-256) { background: #e58fb3; }
  .board :global(.tile-512) { background: #c49add; }
  .board :global(.tile-1024) { background: #9aaef0; }
  .board :global(.tile-2048) { background: #f3d470; }

  .direction-controls {
    display: flex;
    justify-content: center;
    gap: 9px;
    margin-top: 18px;
  }

  .direction-controls button {
    width: 42px;
    height: 38px;
    padding: 0;
  }

  .status {
    min-height: 1.5em;
    margin: 18px 0 0;
    color: var(--playground-muted);
    font-size: 0.9rem;
    text-align: center;
  }

  @media (max-width: 600px) {
    .game-page {
      padding-top: 30px;
    }

    .board {
      gap: 7px;
      padding: 7px;
    }

    .board :global(.tile) {
      border-radius: 6px;
    }

    .game-actions {
      align-items: flex-start;
    }
  }
</style>
