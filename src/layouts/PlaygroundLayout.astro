---
import playgroundImage from "../assets/images/navigation/playground.jpg";

interface Props {
  title: string;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  backHref = "/",
  backLabel = "返回",
} = Astro.props;

const isRepository = Astro.url.pathname.replace(/\/$/, "") === "/playground/game-repository";
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Playground · Albert Frank</title>
  </head>

  <body>
    <header class="playground-header">
      <div class="header-inner">
        <a class="back" href={backHref}>&lt; {backLabel}</a>

        <div class="playground-navigation">
          <nav aria-label="Playground navigation">
            <a
              class="navigation-link"
              href="/playground/game-repository"
              aria-current={isRepository ? "page" : undefined}
            >
              游戏仓库
            </a>
          </nav>

          <img class="playground-icon" src={playgroundImage.src} alt="" />
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --playground-bg: #222a37;
    --playground-fg: #c7dfef;
    --playground-muted: #8e9cab;
    --playground-accent: #64d8ff;
    --playground-border: rgba(199, 223, 239, 0.22);
    --playground-card-bg: #313c4c;
    --playground-content-width: 1180px;

    font-family: Inter, "PingFang SC", "Microsoft YaHei", sans-serif;
    background: var(--playground-bg);
    color: var(--playground-fg);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    background: var(--playground-bg);
  }

  body {
    min-height: 100vh;
  }

  a {
    color: inherit;
    text-decoration: none;
  }
</style>

<style>
  .playground-header {
    width: 100%;
    padding: 26px 28px;
  }

  .header-inner {
    width: min(var(--playground-content-width), calc(100% - 20px));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .back {
    color: var(--playground-muted);
    font-size: 0.95rem;
    white-space: nowrap;
    transition: color 0.18s ease;
  }

  .back:hover,
  .back:focus-visible {
    color: var(--playground-fg);
  }

  .playground-navigation {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .navigation-link {
    color: var(--playground-accent);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .playground-icon {
    width: 46px;
    height: 46px;
    object-fit: cover;
    border: 1px solid var(--playground-border);
    border-radius: 10px;
  }

  @media (max-width: 600px) {
    .playground-header {
      padding: 20px 16px;
    }

    .playground-navigation {
      gap: 14px;
    }

    .navigation-link {
      font-size: 0.82rem;
    }

    .playground-icon {
      width: 38px;
      height: 38px;
    }
  }
</style>
