---
interface Props {
  title: string;
  description: string;
  href: string;
  image?: string;
}

const { title, description, href, image } = Astro.props;
---

<a class="game-card" href={href} aria-label={`开始玩${title}`}>
  {
    image ? (
      <img class="card-image" src={image} alt="" />
    ) : (
      <div class="card-fallback"></div>
    )
  }

  <div class="card-shade"></div>

  <div class="card-info">
    <div class="card-title">{title}</div>
    <div class="card-description">{description}</div>
  </div>
</a>

<style>
  .game-card {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--playground-border);
    border-radius: 14px;
    background: var(--playground-card-bg);
    transition: transform 0.18s ease, border-color 0.18s ease;
  }

  .game-card:hover,
  .game-card:focus-visible {
    transform: translateY(-4px);
    border-color: var(--playground-accent);
  }

  .game-card:focus-visible {
    outline: 2px solid var(--playground-accent);
    outline-offset: 4px;
  }

  .card-image,
  .card-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .card-image {
    object-fit: cover;
  }

  .card-fallback {
    background: linear-gradient(145deg, #344151, #283341);
  }

  .card-shade {
    position: absolute;
    inset: 45% 0 0;
    background: linear-gradient(to bottom, transparent, rgba(13, 18, 25, 0.78));
  }

  .card-info {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 18px;
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .card-description {
    margin-top: 5px;
    color: rgba(225, 237, 245, 0.62);
    font-size: 0.86rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .game-card {
      transition: none;
    }
  }
</style>
