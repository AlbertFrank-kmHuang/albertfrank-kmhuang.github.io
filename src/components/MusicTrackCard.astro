---
import LifeMediaCard from "./LifeMediaCard.astro";

interface Props {
  title: string;
  artist: string;
  image?: string;
  qqSongId: number;
  qqUrl: string;
}

const { title, artist, image, qqSongId, qqUrl } = Astro.props;
const playerUrl = `https://i.y.qq.com/n2/m/outchain/player/index.html?songid=${qqSongId}&songtype=0`;
---

<details class="music-track" data-music-track>
  <summary class="track-toggle" aria-label={`展开或收起《${title}》的播放器`}>
    <LifeMediaCard title={title} subtitle={artist} image={image} />
    <span class="listen-label" aria-hidden="true">
      <span class="listen-open">▶ Listen</span>
      <span class="listen-close">收起</span>
    </span>
  </summary>

  <div class="player-panel">
    <iframe
      data-player-src={playerUrl}
      title={`QQ 音乐：${title} — ${artist}`}
      width="100%"
      height="66"
      allow="autoplay; encrypted-media"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
    <a href={qqUrl} target="_blank" rel="noopener noreferrer">
      在 QQ 音乐中打开 ↗
    </a>
    <noscript><p>点击上方链接收听。</p></noscript>
  </div>
</details>

<script>
  document.querySelectorAll<HTMLDetailsElement>("[data-music-track]").forEach((track) => {
    const player = track.querySelector<HTMLIFrameElement>("iframe[data-player-src]");
    if (!player) return;

    track.addEventListener("toggle", () => {
      if (track.open) {
        // 同时只保留一个播放器；收起时卸载 iframe，让播放停止。
        document.querySelectorAll<HTMLDetailsElement>("[data-music-track][open]").forEach((other) => {
          if (other !== track) other.open = false;
        });
        player.src = player.dataset.playerSrc!;
      } else {
        player.removeAttribute("src");
      }
    });
  });
</script>

<style>
  .music-track { min-width: 0; }
  .track-toggle {
    position: relative;
    display: block;
    cursor: pointer;
    list-style: none;
    border-radius: 14px;
  }
  .track-toggle::-webkit-details-marker { display: none; }
  .track-toggle:focus-visible {
    outline: 2px solid var(--life-text, #e1edf5);
    outline-offset: 5px;
  }
  .listen-label {
    position: absolute;
    top: 16px;
    right: 16px;
    padding: 8px 12px;
    border: 1px solid rgba(225, 237, 245, 0.25);
    border-radius: 999px;
    color: #e1edf5;
    background: rgba(13, 18, 25, 0.72);
    font-size: 0.82rem;
  }
  .track-toggle:hover .listen-label { background: rgba(13, 18, 25, 0.9); }
  .listen-close, .music-track[open] .listen-open { display: none; }
  .music-track[open] .listen-close { display: inline; }
  .player-panel {
    display: grid;
    gap: 12px;
    margin-top: 12px;
    padding: 12px;
    border: 1px solid var(--life-border);
    border-radius: 14px;
    background: var(--life-card-bg);
  }
  iframe { display: block; width: 100%; border: 0; border-radius: 4px; }
  .player-panel a {
    width: fit-content;
    color: inherit;
    font-size: 0.8rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .player-panel p { margin: 0; font-size: 0.8rem; }
</style>
