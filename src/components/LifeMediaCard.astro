---
interface Props {
  title: string;
  subtitle?: string;
  image?: string;
}

const {
  title,
  subtitle,
  image,
} = Astro.props;
---

<article class="media-card">
  {
    image ? (
      <img
        class="media-image"
        src={image}
        alt=""
      />
    ) : (
      <div class="media-fallback"></div>
    )
  }

  <div class="media-shade"></div>

  <div class="media-info">
    <div class="media-title">
      {title}
    </div>

    {
      subtitle && (
        <div class="media-subtitle">
          {subtitle}
        </div>
      )
    }
  </div>
</article>

<style>
  .media-card {
    position: relative;

    width: 100%;
    aspect-ratio: 3 / 4;

    overflow: hidden;

    border:
      1px solid
      var(--life-border);

    border-radius: 14px;

    background:
      var(--life-card-bg);
  }

  .media-image,
  .media-fallback {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;
  }

  .media-image {
    object-fit: cover;
  }

  .media-fallback {
    background:
      linear-gradient(
        145deg,
        #344151,
        #283341
      );
  }

  /*
   * 并不是简单加一个黑色矩形，
   * 而是在图片底部逐渐变暗。
   *
   * 后面我们可以继续升级成
   * backdrop-filter 的真实模糊效果。
   */
  .media-shade {
    position: absolute;

    inset:
      45%
      0
      0;

    background:
      linear-gradient(
        to bottom,
        transparent,
        rgba(13, 18, 25, 0.78)
      );
  }

  .media-info {
    position: absolute;

    left: 20px;
    right: 20px;
    bottom: 18px;
  }

  .media-title {
    font-size: 1.05rem;
    font-weight: 650;

    line-height: 1.3;
  }

  .media-subtitle {
    margin-top: 5px;

    color:
      rgba(
        225,
        237,
        245,
        0.62
      );

    font-size: 0.86rem;
  }
</style>